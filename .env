VITE_API_URL=http://localhost:8000

# Public URL this site is actually reachable at — used to build links
# shared externally (e.g. the article URL posted to LinkedIn).
# window.location.origin is NOT safe for this: it resolves to
# whatever machine you're viewing the page from (localhost while
# developing), which external services like LinkedIn can't reach.
# Point this at a public domain, or a tunnel (ngrok etc.) exposing
# this dev server while testing sharing features locally.
VITE_SITE_URL=http://localhost:3000
