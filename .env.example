# Backend base URL. The FastAPI WhatsApp routes are under /api/v1/whatsapp.
VITE_API_URL=http://127.0.0.1:8000

# Public Meta Embedded Signup configuration. These values are safe to bundle
# into the browser; create the Embedded Signup configuration in Meta first.
VITE_WHATSAPP_META_APP_ID=
VITE_WHATSAPP_META_GRAPH_API_VERSION=v23.0
VITE_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
VITE_API_URL=https://unruly-cabdriver-unrefined.ngrok-free.dev
# Never place WHATSAPP_META_APP_SECRET or WHATSAPP_TOKEN_ENCRYPTION_KEY here.
# They belong exclusively in the backend environment.